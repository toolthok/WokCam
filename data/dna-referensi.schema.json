{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dna-referensi.schema.json",
  "title": "DNA Referensi v1.0",
  "description": "Profil teknik terstruktur hasil analisis video referensi (tahap Amati) dan bahan baku tahap Tiru. Nilai field 'technique' wajib kode katalog yang terdaftar pada katalog-teknik-v1.json; teknik yang belum dikenali masuk ke unknown_techniques.",
  "type": "object",
  "required": ["schema_version", "reference", "style", "beats", "anchors"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "reference": {
      "type": "object",
      "required": ["duration_sec"],
      "properties": {
        "title": { "type": "string" },
        "duration_sec": { "type": "number", "exclusiveMinimum": 0 },
        "aspect_ratio": { "type": "string", "examples": ["9:16", "1:1", "16:9"] },
        "language": { "type": "string", "default": "id" }
      }
    },
    "style": {
      "type": "object",
      "required": ["family"],
      "properties": {
        "family": {
          "type": "string",
          "examples": ["cinematic-storyteller", "fast-cut-energetik", "documentary-narrative", "minimalis-kreator", "data-storyteller", "vlog-kasual"]
        },
        "palette_mood": { "type": "string", "examples": ["warm-neutral", "teal-orange", "cool-clean", "high-contrast"] },
        "tempo": {
          "type": "object",
          "properties": {
            "cuts_per_minute": { "type": "number", "minimum": 0 },
            "avg_shot_sec": { "type": "number", "minimum": 0 }
          }
        },
        "energy_curve": { "type": "array", "items": { "type": "number", "minimum": 0, "maximum": 1 } }
      }
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "start_sec", "end_sec"],
        "properties": {
          "id": { "type": "string" },
          "type": { "enum": ["hook", "konteks", "bukti", "payoff", "CTA"] },
          "start_sec": { "type": "number", "minimum": 0 },
          "end_sec": { "type": "number", "minimum": 0 },
          "summary": { "type": "string" },
          "transcript": { "type": "string" }
        }
      }
    },
    "anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "t_sec", "technique", "layer", "params", "confidence"],
        "properties": {
          "id": { "type": "string" },
          "beat_id": { "type": "string" },
          "t_sec": { "type": "number", "minimum": 0 },
          "tolerance_sec": { "type": "number", "minimum": 0, "default": 0.8, "description": "Pratinjau wajib dikonfirmasi user bila penyimpangan posisi melebihi nilai ini." },
          "technique": { "type": "string", "pattern": "^[A-Z]{2,3}-[A-F][0-9]{2}$" },
          "layer": { "type": "integer", "enum": [1, 2], "description": "1 = video/komposisi tokoh, 2 = grafik/teks/efek. Maksimum dua layer aktif bersamaan." },
          "params": { "type": "object" },
          "asset": {
            "type": "object",
            "properties": {
              "type": { "enum": ["template", "library"], "description": "Hanya aset bawaan aplikasi atau milik user — tidak ada jalur menyalin aset dari video referensi." },
              "ref": { "type": "string" }
            }
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1, "description": "Di bawah ambang 0.75, kartu saran wajib menampilkan pratinjau sebelum konfirmasi." },
          "trigger": {
            "type": "object",
            "properties": {
              "type": { "enum": ["keyword", "beat", "manual"] },
              "value": { "type": "string" }
            }
          }
        }
      }
    },
    "audio_map": {
      "type": "object",
      "properties": {
        "bpm": { "type": "number", "minimum": 0 },
        "beats_sec": { "type": "array", "items": { "type": "number" } },
        "duck_regions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start_sec": { "type": "number" },
              "end_sec": { "type": "number" }
            }
          }
        }
      }
    },
    "unknown_techniques": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["t_sec", "observed"],
        "properties": {
          "t_sec": { "type": "number" },
          "observed": { "type": "string" },
          "suggestion": { "type": "string" }
        }
      }
    }
  }
}
