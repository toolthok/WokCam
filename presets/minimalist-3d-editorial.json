
{
  "id": "minimalist-3d-editorial",
  "name": "Minimalist 3D Editorial Motion",
  "version": "1.1.0",
  "visual": {
    "background": "#F7F7F5",
    "grid": true,
    "gridSize": 36,
    "gridColor": "rgba(20,20,20,0.035)",
    "textColor": "#171717",
    "secondaryColor": "#777A76",
    "fontFamily": "Arial, sans-serif",
    "headlineWeight": 800,
    "bodyWeight": 400
  },
  "composition": {
    "coordinateSystem": "relative-1000",
    "negativeSpace": true,
    "preferredLayout": [
      "editorial",
      "centered",
      "asymmetric",
      "floating-cards"
    ],
    "cardRadius": 18,
    "softShadow": true
  },
  "motion": {
    "defaultEntrance": "fade",
    "defaultEasing": "ease-out",
    "defaultExit": "fade",
    "ambient": [
      "float",
      "slow-zoom",
      "rotate"
    ],
    "staggerInterval": 0.25,
    "sceneDurationMin": 2,
    "sceneDurationMax": 5
  },
  "palette": [
    "#A7C9B5",
    "#B7C8E5",
    "#E9DCCB",
    "#DCE9E1"
  ],
  "supportedElements": [
    "text",
    "card",
    "circle"
  ]
}
